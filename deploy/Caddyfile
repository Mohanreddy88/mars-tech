# HTTPS certificates are issued and renewed automatically by Caddy (Let's Encrypt).
# Both domains serve the same app (option B). DNS for every name below → 189.72.155.35
# Company addresses (esync.marshrms.com, admin.marshrms.com, esync.uat.marshrms.com …) need the
# wildcard DNS records  *  and  *.uat  → 189.72.155.35.

{
	# Certificates for company addresses are issued on first visit, but only for names the
	# app confirms (the Super Admin portal or a registered company) — see :5555 below.
	on_demand_tls {
		ask http://localhost:5555/check
	}
}

(security_headers) {
	encode zstd gzip
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# ── Production ───────────────────────────────────────────────
marstech.tech, marshrms.com {
	import security_headers
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy app:8080
}

# www → apex (same domain)
www.marstech.tech {
	redir https://marstech.tech{uri} permanent
}
www.marshrms.com {
	redir https://marshrms.com{uri} permanent
}

# Company addresses and the Super Admin portal (admin.marshrms.com)
*.marshrms.com, *.marstech.tech {
	tls {
		on_demand
	}
	import security_headers
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy app:8080
}

# ── UAT (separate stack: docker-compose.uat.yml, branch "uat") ──
uat.marstech.tech, uat.marshrms.com {
	import security_headers
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy uat-app:8080
}

*.uat.marshrms.com, *.uat.marstech.tech {
	tls {
		on_demand
	}
	import security_headers
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy uat-app:8080
}

# ── Certificate check (internal only) ───────────────────────
# Caddy calls /check?domain=<name>; production or UAT answers whether that company exists.
http://localhost:5555 {
	bind 127.0.0.1
	@uat expression `{query.domain}.endsWith(".uat.marshrms.com") || {query.domain}.endsWith(".uat.marstech.tech")`
	handle @uat {
		rewrite * /api/platform/domain-check?{query}
		reverse_proxy uat-app:8080
	}
	handle {
		rewrite * /api/platform/domain-check?{query}
		reverse_proxy app:8080
	}
}
