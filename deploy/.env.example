# Copy to deploy/.env on the VPS:  cp .env.example .env  && nano .env
# setup-vps.sh fills the passwords/keys automatically if you let it create .env.

DOMAIN=marstech.tech

POSTGRES_DB=hrms
POSTGRES_USER=hrms
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# 64+ random chars:  openssl rand -base64 64 | tr -d '\n'
JWT_SECRET_KEY=CHANGE_ME

# ── Email (fill whichever you use) ──
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME="HRMS Payroll"
BREVO_API_KEY=
RESEND_API_KEY=
RESEND_FROM=
